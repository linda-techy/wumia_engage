# =====================================================================
#  Engage — LOCAL configuration
#
#  1. Copy this file:   cp config/local.env.example config/local.env
#  2. Edit config/local.env. It is git-ignored, so real values never get committed.
#  3. The app refuses to start while any REQUIRED value still says CHANGE_ME,
#     and it names the variable in the error.
#
#  Format: KEY=value, one per line. No quotes, no spaces around '='.
#  Lines starting with # are comments.
# =====================================================================


# ---------------------------------------------------------------------
# 1. LOCAL POSTGRESQL                                   (REQUIRED, Phase 1)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wumika_admin
# Local login: the postgres superuser. JDBC URL: jdbc:postgresql://localhost:5432/wumika_admin
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
# Separate database for integration tests. Tests write to it freely.
TEST_DB_NAME=wumika_admin_test
# Run Flyway migrations when the app starts. true for local; false in production,
# where migrations run as a separate job before rollout.
FLYWAY_ON_STARTUP=true


# ---------------------------------------------------------------------
# 1b. CUSTOMER ALLOWLIST                                (REQUIRED)
#     The store is live. Only these customers' webhooks are stored and
#     processed; everyone else's are acknowledged and dropped, never written.
#     Comma-separated emails. * = every customer (only when explicitly approved).
#     Empty = the app refuses to start.
# ---------------------------------------------------------------------
CUSTOMER_ALLOWLIST_EMAILS=CHANGE_ME@example.com


# ---------------------------------------------------------------------
# 2. SHOPIFY                                            (REQUIRED, Phase 1)
#    Dev Dashboard -> your app -> Settings
# ---------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# "Client secret". Verifies BOTH webhook HMACs and App Proxy signatures.
SHOPIFY_API_SECRET=CHANGE_ME
# "Client ID". Verifies the aud claim of Thank-you-page session tokens (Phase 2).
SHOPIFY_CLIENT_ID=CHANGE_ME


# ---------------------------------------------------------------------
# 3. RAZORPAY                                           (REQUIRED, Phase 0/1)
#    Dashboard (Test Mode first) -> Account & Settings -> Webhooks -> Add
#    Events: payment.failed, payment.captured, payment.authorized
# ---------------------------------------------------------------------
# The secret YOU TYPE when creating the webhook. This is NOT the API key
# secret. Using the key secret here is the most common reason every
# signature check fails.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# test | live. Logged with every event so test and live data are never confused.
RAZORPAY_MODE=test
# Minutes to look back when matching a failed payment to an open checkout
# by phone + amount (used only when notes carry no checkout reference).
RAZORPAY_MATCH_WINDOW_MINUTES=30


# ---------------------------------------------------------------------
# 4. PUBLIC URL FOR WEBHOOKS                            (REQUIRED to receive webhooks)
#    Shopify and Razorpay only deliver to public HTTPS URLs, never localhost.
#    Run a tunnel (see LOCAL-SETUP.md section 6) and paste its URL here.
# ---------------------------------------------------------------------
PUBLIC_BASE_URL=https://CHANGE_ME.trycloudflare.com


# ---------------------------------------------------------------------
# 5. SERVICE
# ---------------------------------------------------------------------
INGEST_PORT=8080
BUSINESS_TZ=Asia/Kolkata


# ---------------------------------------------------------------------
# 6. FIREBASE / FCM                                     (Phase 2–3, leave blank for now)
# ---------------------------------------------------------------------
# Path to the service-account JSON. Keep the file in config/, which is git-ignored.
FIREBASE_SERVICE_ACCOUNT_FILE=config/firebase-service-account.json
# Public VAPID key from Firebase -> Project settings -> Cloud Messaging -> Web Push certificates.
FIREBASE_WEB_VAPID_PUBLIC_KEY=


# ---------------------------------------------------------------------
# 7. WHATSAPP CLOUD API                                 (Phase 4, leave blank for now)
# ---------------------------------------------------------------------
WA_GRAPH_VERSION=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=


# ---------------------------------------------------------------------
# 8. SMS / DLT                                          (Phase 4, leave blank for now)
# ---------------------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
DLT_ENTITY_ID=


# ---------------------------------------------------------------------
# 9. ADMIN CONSOLE                                      (REQUIRED for admin-api)
# ---------------------------------------------------------------------
ADMIN_API_PORT=8083
# RS256 keypair for access tokens. Generated on first start if absent. Git-ignored.
ADMIN_JWT_KEY_FILE=config/admin-jwt.pem
# 32-byte hex key that encrypts operators' MFA secrets at rest.
# Generate with: openssl rand -hex 32
ADMIN_MFA_KEY=CHANGE_ME
# First OWNER. Used once, while the operators table is empty.
ADMIN_BOOTSTRAP_EMAIL=
