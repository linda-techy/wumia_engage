{%- comment -%}
  Engage push — app embed block (phase-2 §3).
  Everything in EngageConfig is public by design: the Firebase web config is an
  identifier, not a credential, and the VAPID value is the PUBLIC key. Restrict
  the Firebase API key by HTTP referrer in Google Cloud. Identity binding uses
  the App Proxy's signed logged_in_customer_id, never the `loggedIn` flag below.
{%- endcomment -%}
<script>
  window.EngageConfig = {
    proxy: "/apps/push",
    vapidKey: {{ block.settings.vapid_key | json }},
    firebase: {
      apiKey: {{ block.settings.fb_api_key | json }},
      projectId: {{ block.settings.fb_project_id | json }},
      messagingSenderId: {{ block.settings.fb_sender_id | json }},
      appId: {{ block.settings.fb_app_id | json }}
    },
    loggedIn: {{ customer | json | default: 'null' }} != null,
    waNumber: {{ block.settings.wa_number | json }},
    earlyAsk: {
      pageViews: {{ block.settings.early_ask_page_views | json }},
      seconds: {{ block.settings.early_ask_seconds | json }}
    },
    prompt: {
      brand: {{ shop.name | json }},
      logo: {% if block.settings.logo %}{{ block.settings.logo | image_url: width: 96 | prepend: 'https:' | json }}{% else %}null{% endif %},
      headline: {{ block.settings.headline | json }},
      offerText: {{ block.settings.offer_text | json }},
      offerCode: {{ block.settings.offer_code | json }},
      productSeconds: {{ block.settings.product_seconds | json }},
      reaskDays: {{ block.settings.reask_days | json }},
      maxAsks: {{ block.settings.max_asks | json }},
      exitIntent: {{ block.settings.exit_intent | json }},
      bell: {{ block.settings.bell | json }}
    },
    copy: {
      push: {{ block.settings.push_copy | json }},
      pushVersion: {{ block.settings.push_copy_version | json }},
      whatsapp: {{ block.settings.wa_copy | json }},
      whatsappVersion: {{ block.settings.wa_copy_version | json }}
    }
  };
</script>
<script type="module" src="{{ 'engage-push.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'engage-push.css' | asset_url }}">

{% schema %}
{
  "name": "Engage push",
  "target": "body",
  "settings": [
    { "type": "header", "content": "Firebase Cloud Messaging" },
    { "type": "text", "id": "vapid_key", "label": "FCM Web Push certificate (public key)",
      "info": "Firebase console > Project settings > Cloud Messaging > Web Push certificates" },
    { "type": "text", "id": "fb_api_key", "label": "Firebase API key" },
    { "type": "text", "id": "fb_project_id", "label": "Firebase project id", "default": "wumika-75a48" },
    { "type": "text", "id": "fb_sender_id", "label": "Firebase messaging sender id" },
    { "type": "text", "id": "fb_app_id", "label": "Firebase app id" },
    { "type": "header", "content": "When to ask",
      "info": "Our own prompt first; the browser's Allow only after a tap. Also asked at add-to-cart and notify-me." },
    { "type": "range", "id": "early_ask_page_views", "label": "Ask on page view number (0 = off)",
      "min": 0, "max": 5, "step": 1, "default": 2 },
    { "type": "range", "id": "early_ask_seconds", "label": "Or after this many seconds on the site (0 = off)",
      "min": 0, "max": 120, "step": 5, "unit": "s", "default": 20 },
    { "type": "range", "id": "product_seconds", "label": "Product page: ask after this many seconds (0 = off)",
      "info": "A second look at the same piece asks after 4 seconds.",
      "min": 0, "max": 120, "step": 5, "unit": "s", "default": 25 },
    { "type": "checkbox", "id": "exit_intent", "label": "Desktop: ask when the shopper is about to leave", "default": true },
    { "type": "range", "id": "reask_days", "label": "After \"Later\", wait this many days before asking again",
      "min": 1, "max": 30, "step": 1, "unit": "d", "default": 7 },
    { "type": "range", "id": "max_asks", "label": "Ask at most this many times per shopper",
      "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "bell", "label": "After \"Later\", show a bell to subscribe with one tap", "default": true },
    { "type": "header", "content": "Soft-ask look and offer",
      "info": "An offer lifts opt-ins. The code shows only after Allow; create it in Shopify first." },
    { "type": "image_picker", "id": "logo", "label": "Logo on the prompt" },
    { "type": "text", "id": "headline", "label": "Headline (browsing)", "default": "Be the first to know" },
    { "type": "text", "id": "offer_text", "label": "Offer line (shown only when an offer code is set)", "default": "Allow notifications and get 5% off your first order" },
    { "type": "text", "id": "offer_code", "label": "Offer code shown after Allow (blank = none)" },
    { "type": "header", "content": "Opt-in copy",
      "info": "Bump the version whenever you change the wording: it is consent evidence." },
    { "type": "text", "id": "push_copy", "label": "Push soft-ask text",
      "default": "Get new drops first, price-drop and back-in-stock alerts, offers, and live order updates." },
    { "type": "text", "id": "push_copy_version", "label": "Push copy version", "default": "push_v3" },
    { "type": "text", "id": "wa_copy", "label": "WhatsApp opt-in text",
      "default": "Send me order updates and offers from WUMIKA on WhatsApp" },
    { "type": "text", "id": "wa_copy_version", "label": "WhatsApp copy version", "default": "wa_v1" },
    { "type": "text", "id": "wa_number", "label": "WhatsApp number (E.164, e.g. 9198XXXXXXXX)",
      "info": "Used for the iOS / in-app-browser fallback link." }
  ]
}
{% endschema %}
