# /opt/wumika/.env on the server. Fill in from config/devstore.env (dev store,
# never the live store). chmod 600. Never commit the filled-in copy.
# DB_HOST, DB_PORT, INGEST_PORT, ADMIN_API_PORT, WORKER_PORT and
# FIREBASE_SERVICE_ACCOUNT_FILE are set by docker-compose.yml.

DB_NAME=wumika_dev
DB_USER=engage
# openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

CUSTOMER_ALLOWLIST_EMAILS=marylindajohnson22@gmail.com

SHOPIFY_SHOP_DOMAIN=CHANGE_ME.myshopify.com
# Where push links point (cart_recovery -> <this>/cart). The domain the shopper
# subscribed on; blank falls back to https://SHOPIFY_SHOP_DOMAIN.
STOREFRONT_BASE_URL=
SHOPIFY_API_SECRET=CHANGE_ME
SHOPIFY_CLIENT_ID=CHANGE_ME
# Optional: Admin API tokens are fetched automatically with the client ID and
# secret above (client credentials grant). Leave blank unless the store is
# outside the app's Dev Dashboard organization.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
# Web pixel intake (P2-T06); same value as the pixel's webPixelCreate settings.
# Blank = /pixel/events answers 503.
PIXEL_WRITE_KEY=
# Bearer token for ingest-api /prometheus (P1-T05). Blank = /prometheus is 404.
METRICS_TOKEN=
# Date the checkout phone label started showing checkout_notice_v1's text
# (checkout_notice_v2: "Phone (for order updates and offers on WhatsApp/SMS)"),
# e.g. 2026-10-01. Orders from then get WhatsApp order updates and offers on
# that notice (opt-out; STOP always wins). Blank = off.
CHECKOUT_NOTICE_SINCE=
# The live label text: checkout_notice_v2 (default) or checkout_notice_v1 (order updates only).
CHECKOUT_NOTICE_VERSION=checkout_notice_v2
# Shiprocket tracking webhook (P1-T02, ADR-005): invent a long random value
# and paste it as the security token in Shiprocket -> Settings -> API ->
# Webhooks (URL: https://<ingest host>/webhooks/courier). Blank = refused.
COURIER_WEBHOOK_TOKEN=
# Prod only (deploy/prod/backup.sh): rclone remote:path the nightly encrypted
# database dump is copied to, e.g. gdrive:wumika-backups. Must be off-server.
BACKUP_REMOTE=

RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_MODE=test
RAZORPAY_MATCH_WINDOW_MINUTES=30

PUBLIC_BASE_URL=https://engage-dev.wumika.com
BUSINESS_TZ=Asia/Kolkata

# openssl rand -hex 32
ADMIN_MFA_KEY=CHANGE_ME
ADMIN_BOOTSTRAP_EMAIL=CHANGE_ME
