# /opt/wumika/.env on the server. Fill in from config/devstore.env (dev store,
# never the live store). chmod 600. Never commit the filled-in copy.
# DB_HOST, DB_PORT, INGEST_PORT, ADMIN_API_PORT, WORKER_PORT and
# FIREBASE_SERVICE_ACCOUNT_FILE are set by docker-compose.yml.

DB_NAME=wumika_dev
DB_USER=engage
# openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

CUSTOMER_ALLOWLIST_EMAILS=marylindajohnson22@gmail.com

SHOPIFY_SHOP_DOMAIN=CHANGE_ME.myshopify.com
# Where push links point (cart_recovery -> <this>/cart). The domain the shopper
# subscribed on; blank falls back to https://SHOPIFY_SHOP_DOMAIN.
STOREFRONT_BASE_URL=
SHOPIFY_API_SECRET=CHANGE_ME
SHOPIFY_CLIENT_ID=CHANGE_ME
# Admin API token (read_inventory, read_products) for inventory -> variant lookups.
SHOPIFY_ADMIN_TOKEN=CHANGE_ME
SHOPIFY_ADMIN_API_VERSION=2026-07

RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_MODE=test
RAZORPAY_MATCH_WINDOW_MINUTES=30

PUBLIC_BASE_URL=https://engage-dev.wumika.com
BUSINESS_TZ=Asia/Kolkata

# openssl rand -hex 32
ADMIN_MFA_KEY=CHANGE_ME
ADMIN_BOOTSTRAP_EMAIL=CHANGE_ME
